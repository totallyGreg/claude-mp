#!/bin/sh
# Pre-commit hook: validate the marketplace and require version bumps.
# Checks only -- it never edits or stages files.
#
# Blocks the commit when a plugin (or a skill inside it) changed since the
# merge-base with origin/main without raising its version. See
# plugins/foundry/skills/marketplace-manager/SKILL.md "Version rule".
#
# Install: git config core.hooksPath .githooks

set -e

if [ -f ".claude-plugin/marketplace.json" ]; then
    python3 plugins/foundry/skills/marketplace-manager/scripts/repo/validate.py \
        .claude-plugin/marketplace.json --staged
fi
