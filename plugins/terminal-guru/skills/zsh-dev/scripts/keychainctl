#!/bin/zsh
# keychainctl — store and retrieve secrets in the macOS keychain with Apple's built-in
# `security` tool. Needs nothing beyond macOS (zsh, security, plutil).
#
# A secret is one keychain item (service = name, account = $USER) whose Kind records
# its format:
#   secret  one plain value, e.g. an env var       keychainctl get LICENSE_ID
#   json    a bundle of named fields               keychainctl get airs-hol CLIENT_ID
#
# Run `keychainctl --help` for usage.

emulate -R zsh
setopt err_exit no_unset pipe_fail extended_glob

readonly KIND_SECRET=secret KIND_JSON=json

info() { print -u2 -P -- "%F{green}${*//\%/%%}%f" }
die()  { print -u2 -P -- "%F{red}error:%f ${*//\%/%%}"; exit 1 }

has_fzf() { (( $+commands[fzf] )) }
is_tty()  { [[ -t 0 && -t 1 ]] }

# ── Options ─────────────────────────────────────────────────────────────────────
# Sets KEYCHAIN, FIELD, LABEL, FORCE and leaves positionals in ARGS.
parse_opts() {
  local -a o_kc o_field o_label o_force
  zparseopts -D -E -F -- k:=o_kc f:=o_field l:=o_label -force=o_force || die "see: keychainctl --help"
  KEYCHAIN=${o_kc[-1]:-${KEYCHAINCTL_KEYCHAIN:-login}}
  [[ $KEYCHAIN == *.keychain(-db|) ]] || KEYCHAIN+=.keychain
  FIELD=${o_field[-1]:-} LABEL=${o_label[-1]:-}
  FORCE=$(( $#o_force ))
  local i=${@[(i)--]}
  (( i > $# )) || argv[i]=()   # drop the end-of-options marker, keep what follows
  ARGS=("$@")
  [[ $FIELD != *.* ]] || die "Field names can't contain '.': $FIELD"
}

# ── Keychain access ─────────────────────────────────────────────────────────────
read_item() { security find-generic-password -a $USER -s $1 -w -- $KEYCHAIN 2>/dev/null }

item_attr() {  # item_attr <name> <attr>  e.g. 0x00000007 (label)
  security find-generic-password -a $USER -s $1 -- $KEYCHAIN 2>/dev/null \
    | sed -n "s/^ *$2 <blob>=\"\\(.*\\)\"\$/\\1/p" || true   # new item: no attrs yet
}

write_item() {  # write_item <name> <value> — Kind follows the value; label is kept unless -l
  local kind=$KIND_SECRET label=$LABEL
  local -a label_opt
  is_json "$2" && kind=$KIND_JSON
  [[ -n $label ]] || label=$(item_attr "$1" 0x00000007)
  [[ -z $label ]] || label_opt=(-l "$label")
  security add-generic-password -U -a $USER -s "$1" -D $kind "${label_opt[@]}" -w "$2" -- $KEYCHAIN \
    || die "Failed to store '$1' in $KEYCHAIN"
}

list_services() {
  local -a lines=(${(f)"$(security dump-keychain -- $KEYCHAIN 2>/dev/null)"})
  lines=(${(M)lines:#[[:space:]]#\"svce\"\<blob\>=\"*\"})
  print -rl -- ${(ou)${${lines#*\"svce\"\<blob\>=\"}%\"}}
}

pick_service() {
  has_fzf && is_tty || die $1
  list_services | fzf --prompt="Secret> " || die "No secret selected"
}

# ── JSON (via plutil) ───────────────────────────────────────────────────────────
is_json() { [[ $1 == [[:space:]]#\{* ]] && plutil -convert json -o /dev/null - <<< "$1" 2>/dev/null }
json_compact() { plutil -convert json -o - - <<< "$1" }
json_get()     { plutil -extract $2 raw -o - - <<< "$1" 2>/dev/null }
# Edits go via XML: plutil can't write '{}' back as JSON (it reads it as an OpenStep plist)
json_edit()    { plutil -convert xml1 -o - - <<< "$1" | plutil "${@:2}" -o - - | plutil -convert json -o - - }
json_set()     { json_edit "$1" -replace "$2" -string "$3" }
json_del()     { json_edit "$1" -remove "$2" }
json_keys() {
  local -a keys=(${(f)"$(plutil -convert xml1 -o - - <<< "$1" | sed -n 's/^	<key>\(.*\)<\/key>$/\1/p')"})
  keys=(${keys//&lt;/<}); keys=(${keys//&gt;/>}); keys=(${keys//&amp;/&})
  print -rl -- $keys
}

# ── Guards ──────────────────────────────────────────────────────────────────────
# Secrets don't contain whitespace or shell syntax; either usually means a paste or
# quoting mistake (e.g. the clipboard held the command, not the key).
looks_wrong() { [[ $1 == *([[:space:]]|'$('|'`')* ]] }

check_value() {
  (( FORCE )) && return 0
  local -a bad
  if is_json "$1"; then
    local k
    for k in ${(f)"$(json_keys "$1")"}; do looks_wrong "$(json_get "$1" "$k")" && bad+=($k); done
  else
    looks_wrong "$1" && bad=(value)
  fi
  (( $#bad )) || return 0
  die "Suspicious ${(j:, :)bad}: contains whitespace, '\$(' or a backtick — likely a paste or quoting mistake.
  Check what you pasted, or use --force if it's intentional."
}

# Replacing a JSON item must not silently drop fields it already has.
check_no_dropped_fields() {  # <name> <existing> <new>
  (( FORCE )) && return 0
  is_json "$2" || return 0
  local -a old=(${(f)"$(json_keys "$2")"}) new=()
  is_json "$3" && new=(${(f)"$(json_keys "$3")"})
  local -a dropped=(${old:|new})
  (( $#dropped )) || return 0
  die "Would drop fields from '$1': ${(j:, :)dropped}
  Use 'set $1 -f FIELD VALUE' to change one field, or --force to replace the whole item."
}

# ── Commands ────────────────────────────────────────────────────────────────────
cmd_get() {
  parse_opts "$@"
  local name=${ARGS[1]:-} field=${FIELD:-${ARGS[2]:-}} value
  [[ -n $name ]] || name=$(pick_service "Usage: keychainctl get <name> [field]")
  value=$(read_item "$name") || die "'$name' not found in $KEYCHAIN"

  if [[ -n $field ]]; then
    is_json "$value" || die "'$name' has no fields (it holds a single value)"
    json_get "$value" "$field" || die "Field '$field' not found in '$name'"
  elif is_json "$value"; then
    local k
    for k in ${(f)"$(json_keys "$value")"}; do print -r -- "$k=$(json_get "$value" "$k")"; done
  else
    print -r -- $value
  fi
}

# store_whole <name> <value> — shared by `set` (no -f) and `import`
store_whole() {
  local existing
  existing=$(read_item "$1") || existing=
  check_value "$2"
  check_no_dropped_fields "$1" "$existing" "$2"
  local value=$2
  is_json "$value" && value=$(json_compact "$value")
  write_item "$1" "$value"
  info "Stored '$1' in $KEYCHAIN"
}

cmd_set() {
  parse_opts "$@"
  local name=${ARGS[1]:-} value
  [[ -n $name ]] || die "Usage: keychainctl set <name> [-f field] [value | -]"

  if (( $#ARGS < 2 )); then
    is_tty || die "No value given and not a TTY (pass a value, or '-' to read stdin)"
    read -rs "value?Value for '$name${FIELD:+ → $FIELD}': " < /dev/tty; print -u2
  elif [[ ${ARGS[2]} == - ]]; then
    value=$(cat)
  else
    value=${ARGS[2]}
  fi
  [[ -n $value ]] || die "Value cannot be empty"

  if [[ -z $FIELD ]]; then
    store_whole "$name" "$value"
    return
  fi

  check_value "$value"
  local existing
  existing=$(read_item "$name") || existing='{}'
  is_json "$existing" || die "'$name' holds a single value, not fields; refusing to overwrite (use 'set $name' without -f)"
  write_item "$name" "$(json_set "$existing" "$FIELD" "$value")"
  info "Set $FIELD in '$name' ($KEYCHAIN)"
}

cmd_import() {
  parse_opts "$@"
  local name=${ARGS[1]:-} src=${ARGS[2]:-} json
  [[ -n $name ]] || die "Usage: keychainctl import <name> [file | -]"

  if [[ -n $src && $src != - ]]; then
    json=$(<$src)
  elif [[ -n $src || ! -t 0 ]]; then
    json=$(cat)
  else
    # Hidden multi-line paste: echo off so the JSON never appears on screen or in history
    print -u2 "Paste JSON for '$name', then press Ctrl-D:"
    stty -echo; trap 'stty echo' EXIT
    json=$(cat < /dev/tty)
    stty echo; trap - EXIT; print -u2
  fi
  is_json "$json" || die "Input is not a JSON object"
  store_whole "$name" "$json"
}

cmd_rm() {
  parse_opts "$@"
  local name=${ARGS[1]:-} existing
  [[ -n $name ]] || die "Usage: keychainctl rm <name> [-f field]"

  if [[ -n $FIELD ]]; then
    existing=$(read_item "$name") || die "'$name' not found in $KEYCHAIN"
    is_json "$existing" || die "'$name' has no fields (it holds a single value)"
    (( ${${(f)"$(json_keys "$existing")"}[(Ie)$FIELD]} )) || die "Field '$FIELD' not found in '$name'"
    write_item "$name" "$(json_del "$existing" "$FIELD")"
    info "Removed $FIELD from '$name' ($KEYCHAIN)"
    return
  fi

  security delete-generic-password -a $USER -s $name -- $KEYCHAIN &>/dev/null \
    || die "'$name' not found in $KEYCHAIN"
  info "Deleted '$name' from $KEYCHAIN"
}

cmd_ls() {
  parse_opts "$@"
  if has_fzf && is_tty; then
    list_services | fzf --multi --prompt="Secrets in $KEYCHAIN> " \
      --header="TAB=multi-select, ENTER=confirm, ctrl-y=yank selected" \
      --bind="ctrl-y:execute-silent(echo -n {+} | pbcopy)+abort" || true
  else
    list_services
  fi
}

# Compatibility with the old 'pair' commands (existing mise exec() strings use 'pair get').
cmd_pair() {
  local sub=${1:-}; (( $# )) && shift
  case $sub in
    get)        cmd_get "$@" ;;
    rm|delete)  cmd_rm "$@" ;;
    ls|list)    cmd_ls "$@" ;;
    set|update)
      local name=${1:-}; (( $# )) && shift
      [[ -n $name && $# -gt 0 ]] || die "Usage: keychainctl set <name> -f FIELD [value]"
      if [[ $1 == \{* || $1 == - ]]; then cmd_set $name "$@"; return; fi
      local kv
      for kv in "$@"; do
        [[ $kv == ?*=* ]] || die "Expected FIELD=value, got '$kv' (see: keychainctl set <name> -f FIELD [value])"
        cmd_set $name -f ${kv%%=*} -- ${kv#*=}
      done ;;
    *) die "Unknown pair subcommand: '$sub'. 'pair' is deprecated — use get/set/import/rm." ;;
  esac
}

usage() {
  print -u2 -r -- "Usage: keychainctl <command> [options] [args]

A secret holds one value (Kind: secret) or a bundle of named fields (Kind: json).

Commands:
  get <name> [field]            One value → the value; a bundle → KEY=val lines, or one field
  set <name> [value | -]        Store one value (hidden prompt if omitted; '-' reads stdin)
  set <name> -f FIELD [value]   Add or change one field of a bundle, keeping the others
  import <name> [file | -]      Store a JSON bundle from a file, stdin, or a hidden paste
  rm  <name> [-f FIELD]         Delete a secret, or one field
  ls                            List secrets (interactive with fzf if available)

Options:
  -k KEYCHAIN   Keychain to use (default: \$KEYCHAINCTL_KEYCHAIN or login)
  -f FIELD      Operate on one field of a bundle (no '.' in field names)
  -l LABEL      Name shown in Keychain Access (kept on later writes)
  --force       Allow replacing a bundle's fields, or a value that looks like a paste
                mistake (whitespace, '\$(', backtick)
  --            End of options (for values starting with '-')

Examples:
  ASANA_TOKEN=\$(keychainctl get CLAUDE_ASANA)
  keychainctl set customer-success-LICENSE_ID            # hidden prompt
  keychainctl import airs-hol                            # paste JSON, Ctrl-D; nothing in history
  pbpaste | keychainctl import airs-hol
  keychainctl get airs-hol CLIENT_ID
  keychainctl set airs-hol -f PALO_ALTO_API_KEY          # rotate one field, hidden prompt
  eval \"\$(keychainctl get airs-hol | sed 's/^/export /')\"
  keychainctl ls -k work"
  exit 0
}

typeset -g KEYCHAIN FIELD LABEL FORCE
typeset -ga ARGS

cmd=${1:-}; (( $# )) && shift
case $cmd in
  get)          cmd_get "$@" ;;
  set)          cmd_set "$@" ;;
  import)       cmd_import "$@" ;;
  rm|delete)    cmd_rm "$@" ;;
  ls|list)      cmd_ls "$@" ;;
  pair)         cmd_pair "$@" ;;
  -h|--help|'') usage ;;
  *)            die "Unknown command: $cmd. Run 'keychainctl --help' for usage." ;;
esac
