#!/usr/bin/env bash
#
# handoff — deliver a structured handoff payload via clipboard, file, or tmux.
#
# The orchestration path (SendMessage to a teammate) is handled by the calling
# agent directly using the SendMessage tool — this script does NOT handle that.
# This script covers transports that need external IPC: clipboard, file, tmux.
#
# Payload is read from stdin. The script does not generate content.
#
# Usage:
#   handoff --to clipboard                                      # pbcopy / xclip / wl-copy
#   handoff --to file:<path>                                    # write to path with chmod 600
#   handoff --to tmux:<address> [--filter <re>]                 # send to session:window.pane
#   handoff --to tmux:auto [--filter <re>]                      # pick first pane matching filter
#
# Options:
#   --from <name>             Sender identifier shown in the pointer message (default: "agent")
#   --filter <regex>          Restrict delivery to panes whose current command matches.
#                             Defaults to "claude" for tmux:* (safety: avoids delivering
#                             instructions to a shell prompt). Pass --filter '.*' to disable.
#   --filter-address <regex>  Restrict delivery to panes whose pane address matches.
#                             Composed with --filter (AND). Example: --filter claude
#                             --filter-address "airs/project" targets the claude pane in
#                             that session. Session names may contain letters, digits, _, -, .,
#                             and / but must not begin with - or contain ..
#
# Exit codes:
#   0   delivered
#   1   usage error
#   2   transport error (no clipboard tool, tmux not found, target not found, etc.)
#   3   security error (user-supplied path failed validation)

set -euo pipefail

# ---------------------------------------------------------------------------
# Defaults
# ---------------------------------------------------------------------------

TO=""
FROM="agent"
FILTER=""
FILTER_ADDRESS=""
FILTER_EXPLICIT=false

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

die() { echo "handoff: $*" >&2; exit "${2:-1}"; }

usage() {
  sed -n '3,28p' "$0" | sed 's/^# \?//'
  exit "${1:-0}"
}

# Validate a USER-SUPPLIED path before interpolating it into a shell-visible
# message or filesystem operation. Script-generated paths are not validated
# (they're constructed from $$ and $(date +%s) — guaranteed safe).
validate_user_path() {
  local path="$1"
  if [[ ! "$path" =~ ^[/a-zA-Z0-9._-]+$ ]]; then
    die "path contains unsafe characters: $path" 3
  fi
}

# ---------------------------------------------------------------------------
# Transports
# ---------------------------------------------------------------------------

transport_clipboard() {
  if command -v pbcopy >/dev/null 2>&1; then
    pbcopy
    echo "handoff: copied to clipboard (pbcopy)"
  elif command -v xclip >/dev/null 2>&1; then
    xclip -selection clipboard
    echo "handoff: copied to clipboard (xclip)"
  elif command -v wl-copy >/dev/null 2>&1; then
    wl-copy
    echo "handoff: copied to clipboard (wl-copy)"
  else
    die "no clipboard tool found (pbcopy/xclip/wl-copy)" 2
  fi
}

transport_file() {
  local path="$1"
  validate_user_path "$path"
  local dir
  dir="$(dirname "$path")"
  [[ -d "$dir" ]] || die "directory does not exist: $dir" 2
  ( umask 077 && cat > "$path" )
  chmod 600 "$path"
  echo "handoff: wrote payload to $path (mode 600)"
}

# Resolve a tmux pane address. Two forms accepted:
#   "auto"               → first pane matching --filter
#   "session:window.pane" → used as-is (must pass --filter)
resolve_tmux_target() {
  local target="$1"
  local filter="$2"
  local filter_address="${3:-}"

  command -v tmux >/dev/null 2>&1 || die "tmux not found on PATH" 2

  local panes
  panes="$(tmux list-panes -a -F '#{session_name}:#{window_index}.#{pane_index}	#{pane_current_command}' 2>/dev/null)" \
    || die "tmux list-panes failed (is a tmux server running?)" 2

  if [[ -n "$filter" || -n "$filter_address" ]]; then
    panes="$(printf '%s\n' "$panes" | awk -F'\t' \
      -v addr="$filter_address" -v cmd="$filter" \
      '(addr == "" || $1 ~ addr) && (cmd == "" || $2 ~ cmd) { print }' || true)"
    [[ -n "$panes" ]] || die "no panes match --filter / --filter-address" 2
  fi

  if [[ "$target" == "auto" ]]; then
    local count
    count="$(printf '%s\n' "$panes" | wc -l | tr -d ' ')"
    if [[ "$count" -gt 1 ]]; then
      echo "handoff: multiple matching panes, picking first. Use --filter-address or --to tmux:<address> to target a specific pane:" >&2
      printf '%s\n' "$panes" | awk -F'\t' '{ print "  " $1 "\t(" $2 ")" }' >&2
    fi
    printf '%s' "$panes" | head -n1 | awk -F'\t' '{ print $1 }'
    return
  fi

  # Explicit session:window.pane — first char must be alnum or underscore (no leading -, /, .)
  if [[ "$target" =~ ^[A-Za-z0-9_][A-Za-z0-9_./-]*:[0-9]+\.[0-9]+$ ]]; then
    # Reject path-traversal-shaped session names
    local session_name="${target%%:*}"
    if [[ "$session_name" == *..* || "$session_name" == */./* || "$session_name" == */ ]]; then
      die "invalid tmux target: $target (session name contains path-traversal characters)" 1
    fi
    if printf '%s\n' "$panes" | awk -F'\t' -v t="$target" '$1 == t { found=1 } END { exit !found }'; then
      printf '%s' "$target"
      return
    fi
    die "pane $target not found (or did not pass --filter / --filter-address)" 2
  fi

  die "invalid tmux target: $target (expected 'auto' or 'session:window.pane'; session names may contain letters, digits, _, -, ., / but must not start with - or contain ..)" 1
}

transport_tmux() {
  local target_spec="$1"
  local filter="$2"

  local pane
  pane="$(resolve_tmux_target "$target_spec" "$filter" "$FILTER_ADDRESS")"

  # Build payload file — path is script-generated, no validation needed
  local tmpdir="${TMPDIR:-/tmp}"
  local file
  file="${tmpdir%/}/handoff-$$-$(date +%s).md"
  ( umask 077 && cat > "$file" )
  chmod 600 "$file"

  # Pointer message — short, plain ASCII, contains no payload content.
  local msg="[handoff from ${FROM}] Read ${file} and acknowledge in conversation."

  # Two-call delivery: literal message + explicit Enter.
  # -l ensures the message body is sent literally (no key-name interpretation).
  # The Enter must NOT use -l so tmux interprets it as the Return key.
  tmux send-keys -t "$pane" -l "$msg"
  tmux send-keys -t "$pane" Enter

  echo "handoff: sent to $pane (payload at $file)"
}

# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------

while [[ $# -gt 0 ]]; do
  case "$1" in
    --to)
      [[ $# -ge 2 ]] || die "--to requires an argument"
      TO="$2"; shift 2 ;;
    --from)
      [[ $# -ge 2 ]] || die "--from requires an argument"
      FROM="$2"; shift 2 ;;
    --filter)
      [[ $# -ge 2 ]] || die "--filter requires an argument"
      FILTER="$2"; FILTER_EXPLICIT=true; shift 2 ;;
    --filter-address)
      [[ $# -ge 2 ]] || die "--filter-address requires an argument"
      FILTER_ADDRESS="$2"; shift 2 ;;
    -h|--help)
      usage 0 ;;
    *)
      die "unknown argument: $1 (try --help)" ;;
  esac
done

[[ -n "$TO" ]] || die "--to is required (try --help)"

# Apply default --filter claude for tmux transports (safety)
if [[ "$TO" == tmux:* ]] && [[ "$FILTER_EXPLICIT" == false ]]; then
  FILTER="claude"
fi

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------

case "$TO" in
  clipboard)
    transport_clipboard ;;
  file:*)
    transport_file "${TO#file:}" ;;
  tmux:*)
    transport_tmux "${TO#tmux:}" "$FILTER" ;;
  *)
    die "unknown transport: $TO (expected clipboard, file:<path>, or tmux:<target>)" ;;
esac
